<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AutoLispTest.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FSharp.AutoLisp\FSharp.AutoLisp.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.assert" Version="4.0.3" />
        <PackageReference Include="xunit.v3.core.mtp-v2" Version="4.0.3" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="11.0.101" />
    </ItemGroup>

</Project>
